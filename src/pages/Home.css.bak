/* =============================================
   PAGE LOADER
   ============================================= */
.page-loader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  animation: loaderExit 0.6s cubic-bezier(0.4, 0, 0.2, 1) 2.3s forwards;
}

@keyframes loaderExit {
  0%   { opacity: 1; pointer-events: auto; }
  100% { opacity: 0; pointer-events: none; }
}

.loader-logo-img {
  width: 220px;
  height: auto;
  animation: loaderLogoIn 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.15s both;
}

@keyframes loaderLogoIn {
  from { opacity: 0; transform: scale(0.6) translateY(20px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* thin red divider line under logo before bar */
/* .page-loader::after {
  content: '';
  display: block;
  width: 60px;
  height: 2px;
  background: #C81010;
  border-radius: 2px;
  margin-top: 1.2rem;
  animation: loaderBarAppear 0.3s ease 0.8s both;
} */

.loader-bar {
  width: 160px;
  height: 3px;
  background: rgba(200,16,16,0.12);
  border-radius: 3px;
  margin-top: 2.2rem;
  overflow: hidden;
  opacity: 0;
  animation: loaderBarAppear 0.3s ease 0.9s forwards;
}

@keyframes loaderBarAppear {
  to { opacity: 1; }
}

.loader-bar-fill {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #C81010, #FF4D4D);
  border-radius: 3px;
  animation: loaderBarFill 1.6s cubic-bezier(0.4, 0, 0.2, 1) 1s forwards;
}

@keyframes loaderBarFill {
  to { width: 100%; }
}

/* =============================================
   HOME PAGE WRAPPER
   ============================================= */
.home-page {
  opacity: 0;
  transition: opacity 0.5s ease;
}

.home-page.ready {
  opacity: 1;
}

/* =============================================
   SHARED SECTION UTILITIES
   ============================================= */
.section-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding-left: var(--px);
  padding-right: var(--px);
}

.section-kicker {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #C81010;
  display: block;
  margin-bottom: 0.6rem;
}

.section-title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  line-height: 1.1;
  text-transform: uppercase;
  letter-spacing: -0.01em;
}

.section-title .accent { color: #C81010; }

/* =============================================
   REVEAL ANIMATIONS
   ============================================= */
.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.75s ease, transform 0.75s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

.reveal-left {
  opacity: 0;
  transform: translateX(-50px);
  transition: opacity 0.75s ease, transform 0.75s ease;
}

.reveal-left.visible {
  opacity: 1;
  transform: translateX(0);
}

.reveal-right {
  opacity: 0;
  transform: translateX(50px);
  transition: opacity 0.75s ease, transform 0.75s ease;
}

.reveal-right.visible {
  opacity: 1;
  transform: translateX(0);
}

.reveal-d1 { transition-delay: 0.1s; }
.reveal-d2 { transition-delay: 0.2s; }
.reveal-d3 { transition-delay: 0.3s; }
.reveal-d4 { transition-delay: 0.4s; }
.reveal-d5 { transition-delay: 0.5s; }

/* =============================================
   HERO SECTION
   ============================================= */
.hero-section {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #fff;
  padding: 5rem 0 3rem;
}

.hero-section::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 42%;
  height: 100%;
  background: #C81010;
  clip-path: polygon(15% 0, 100% 0, 100% 100%, 0 100%);
  z-index: 0;
}

.hero-section::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 80px;
  background: #fff;
  clip-path: polygon(0 60%, 100% 0, 100% 100%, 0 100%);
  z-index: 3;
}

.hero-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--px);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  position: relative;
  z-index: 2;
  width: 100%;
}

/* Hero copy (left) */
.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.hero-kicker {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #C81010;
  margin-bottom: 1rem;
  display: block;
  animation: heroSlideLeft 0.8s ease 2.5s both;
}

.hero-headline {
  font-size: clamp(2.8rem, 5.5vw, 5rem);
  font-weight: 900;
  line-height: 0.95;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  color: #0D0D0D;
  margin-bottom: 1.4rem;
  animation: heroSlideLeft 0.8s ease 2.65s both;
}

.hero-headline .red { color: #C81010; }

.hero-desc {
  font-size: 0.95rem;
  line-height: 1.7;
  color: #555;
  max-width: 48ch;
  margin-bottom: 2rem;
  animation: heroSlideLeft 0.8s ease 2.8s both;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  animation: heroSlideLeft 0.8s ease 2.95s both;
}

@keyframes heroSlideLeft {
  from { opacity: 0; transform: translateX(-30px); }
  to   { opacity: 1; transform: translateX(0); }
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1.6rem;
  background: #C81010;
  color: #fff;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: none;
  border-radius: 999px;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(200,16,16,0.35);
  transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  cursor: pointer;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(200,16,16,0.45);
  background: #a80d0d;
}

.btn-primary .btn-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.85rem 1.4rem;
  background: transparent;
  color: #0D0D0D;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: color 0.2s ease;
}

.btn-ghost:hover { color: #C81010; }

.btn-ghost .play-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 2px solid #0D0D0D;
  border-radius: 50%;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.btn-ghost:hover .play-ring {
  border-color: #C81010;
  background: rgba(200,16,16,0.06);
}

/* Hero visual (right) */
.hero-visual-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: heroScaleIn 1s cubic-bezier(0.34, 1.2, 0.64, 1) 2.6s both;
}

@keyframes heroScaleIn {
  from { opacity: 0; transform: scale(0.88); }
  to   { opacity: 1; transform: scale(1); }
}

.hero-banner-img {
  width: 100%;
  max-width: 540px;
  height: auto;
  object-fit: contain;
  display: block;
  filter: drop-shadow(0 24px 60px rgba(200,16,16,0.22));
  border-radius: 12px;
}

/* =============================================
   STATS SECTION
   ============================================= */
.stats-section {
  padding: 4rem 0;
  background: #fff;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

.stats-grid {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--px);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.5rem 2rem;
  border-right: 1px solid rgba(0,0,0,0.08);
}

.stat-item:last-child { border-right: none; }

.stat-icon {
  flex-shrink: 0;
  width: 52px;
  height: 52px;
}

.stat-icon svg { width: 100%; height: 100%; }

.stat-info { display: flex; flex-direction: column; gap: 0.15rem; }

.stat-value {
  font-size: clamp(1.5rem, 2.5vw, 2.2rem);
  font-weight: 900;
  color: #0D0D0D;
  line-height: 1;
}

.stat-label {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #888;
}

/* =============================================
   SERVICES SECTION
   ============================================= */
.services-section {
  padding: 6rem 0 5rem;
  background: #F9F9F9;
}

.services-head {
  text-align: center;
  margin-bottom: 3.5rem;
}

.services-head .section-title {
  margin-top: 0.4rem;
}

.services-divider {
  display: block;
  width: 50px;
  height: 3px;
  background: #C81010;
  margin: 1rem auto 0;
  border-radius: 2px;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.service-card {
  position: relative;
  border-radius: var(--r-lg);
  overflow: hidden;
  min-height: 360px;
  cursor: pointer;
}

.service-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  transition: transform 0.5s ease;
}

.service-card:hover .service-card-img { transform: scale(1.06); }

.service-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 20%, rgba(0,0,0,0.88) 90%);
  transition: background 0.3s ease;
}

.service-card:hover .service-card-overlay {
  background: linear-gradient(180deg, rgba(200,16,16,0.15) 0%, rgba(0,0,0,0.92) 90%);
}

.service-card-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem;
  z-index: 2;
}

.service-card-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(200,16,16,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.8rem;
}

.service-card-icon svg { width: 20px; height: 20px; }

.service-card-title {
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #fff;
  margin-bottom: 0.5rem;
}

.service-card-desc {
  font-size: 0.82rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.8);
  margin-bottom: 1rem;
}

.service-card-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.5);
  color: #fff;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.service-card:hover .service-card-arrow {
  background: #C81010;
  border-color: #C81010;
}

/* =============================================
   WHY CHOOSE US
   ============================================= */
.why-section {
  padding: 0;
  background: #0D0D0D;
  overflow: hidden;
}

.why-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--px);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  min-height: 600px;
}

.why-image-col {
  position: relative;
  overflow: hidden;
}

.why-image {
  width: 100%;
  height: 100%;
  min-height: 500px;
  object-fit: cover;
  opacity: 0.7;
  transition: opacity 0.4s ease;
}

.why-image-col:hover .why-image { opacity: 0.85; }

.why-image-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, transparent 60%, #0D0D0D 100%);
}

.why-copy-col {
  padding: 5rem 3rem 5rem 3.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.why-headline {
  font-size: clamp(2.2rem, 4vw, 3.4rem);
  font-weight: 900;
  line-height: 1;
  text-transform: uppercase;
  color: #fff;
  margin: 0.5rem 0 2.5rem;
  letter-spacing: -0.01em;
}

.why-headline .accent { color: #C81010; }

.why-features {
  display: flex;
  flex-direction: column;
  gap: 1.3rem;
  margin-bottom: 2.5rem;
}

.why-feature {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.why-feature-icon {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1.5px solid rgba(200,16,16,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(200,16,16,0.08);
  margin-top: 2px;
}

.why-feature-icon svg { width: 18px; height: 18px; }

.why-feature-text {}

.why-feature-title {
  font-size: 0.88rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 0.2rem;
}

.why-feature-desc {
  font-size: 0.8rem;
  line-height: 1.55;
  color: #888;
}

.btn-outline-red {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.8rem 1.6rem;
  background: #C81010;
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: none;
  border-radius: 999px;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(200,16,16,0.35);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  align-self: flex-start;
}

.btn-outline-red:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(200,16,16,0.45);
}

/* =============================================
   PORTFOLIO SECTION
   ============================================= */
.portfolio-section {
  background: #111;
  padding: 6rem 0 5rem;
}

.portfolio-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}

.portfolio-head-left {}

.portfolio-title {
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  font-weight: 900;
  text-transform: uppercase;
  color: #fff;
  margin-top: 0.3rem;
}

.portfolio-title .accent { color: #C81010; }

.btn-outline-white {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 1.3rem;
  border: 1.5px solid rgba(255,255,255,0.3);
  border-radius: 999px;
  color: #fff;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: transparent;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.25s ease, border-color 0.25s ease;
  flex-shrink: 0;
}

.btn-outline-white:hover {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.6);
}

.portfolio-filters {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.filter-tab {
  padding: 0.45rem 1rem;
  border: 1.5px solid rgba(255,255,255,0.15);
  border-radius: 999px;
  background: transparent;
  color: #888;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.22s ease;
}

.filter-tab:hover { border-color: rgba(255,255,255,0.4); color: #fff; }

.filter-tab.active {
  background: #C81010;
  border-color: #C81010;
  color: #fff;
  box-shadow: 0 4px 14px rgba(200,16,16,0.3);
}

.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 0.8rem;
}

.portfolio-item {
  position: relative;
  border-radius: var(--r-md);
  overflow: hidden;
  aspect-ratio: 4/3;
  cursor: pointer;
  transition: opacity 0.35s ease, transform 0.35s ease;
}

.portfolio-item.hidden {
  opacity: 0;
  transform: scale(0.92);
  pointer-events: none;
  display: none;
}

.portfolio-item-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.portfolio-item:hover .portfolio-item-img { transform: scale(1.08); }

.portfolio-item-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.9) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.portfolio-item:hover .portfolio-item-overlay { opacity: 1; }

.portfolio-item-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0.8rem;
  transform: translateY(8px);
  opacity: 0;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.portfolio-item:hover .portfolio-item-info { opacity: 1; transform: translateY(0); }

.portfolio-item-name {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  display: block;
}

.portfolio-item-cat {
  font-size: 0.62rem;
  color: rgba(255,255,255,0.65);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.portfolio-item-arrow {
  position: absolute;
  top: 0.7rem;
  right: 0.7rem;
  width: 28px;
  height: 28px;
  background: #C81010;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.portfolio-item:hover .portfolio-item-arrow { opacity: 1; }

/* =============================================
   CLIENTS SECTION
   ============================================= */
.clients-section {
  padding: 4.5rem 0;
  background: #fff;
  border-top: 1px solid rgba(0,0,0,0.06);
}

.clients-kicker {
  text-align: center;
  margin-bottom: 2.5rem;
}

.clients-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(2rem, 4vw, 5rem);
  flex-wrap: wrap;
}

.client-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.45;
  transition: opacity 0.3s ease;
  filter: grayscale(1);
}

.client-logo:hover { opacity: 0.9; filter: grayscale(0); }

.client-logo svg { height: 28px; width: auto; }

/* =============================================
   CTA SECTION
   ============================================= */
.cta-section {
  position: relative;
  background: linear-gradient(120deg, #8B0000 0%, #C81010 45%, #FF1A1A 100%);
  padding: 5.5rem 0;
  overflow: hidden;
}

.cta-section::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -5%;
  width: 40%;
  height: 200%;
  background: rgba(0,0,0,0.12);
  transform: rotate(-12deg);
}

.cta-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--px);
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 3rem;
  position: relative;
  z-index: 2;
}

.cta-text {}

.cta-small {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 0.5rem;
}

.cta-headline {
  font-size: clamp(2rem, 4.5vw, 3.6rem);
  font-weight: 900;
  text-transform: uppercase;
  color: #fff;
  line-height: 1.05;
  letter-spacing: -0.01em;
}

.cta-right { display: flex; flex-direction: column; gap: 1rem; align-items: flex-end; }

.cta-desc {
  font-size: 0.9rem;
  line-height: 1.65;
  color: rgba(255,255,255,0.75);
  max-width: 36ch;
  text-align: right;
}

.btn-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.9rem 1.8rem;
  background: #0D0D0D;
  color: #fff;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: none;
  border-radius: 999px;
  text-decoration: none;
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
}

.btn-cta:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(0,0,0,0.4); }

/* Decorative antenna shapes inside CTA */
.cta-deco {
  position: absolute;
  right: 3%;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0.12;
  width: 160px;
  height: 200px;
  z-index: 1;
}

/* =============================================
   RESPONSIVE
   ============================================= */

/* Prevent horizontal overflow site-wide */
.hero-section,
.stats-section,
.services-section,
.why-section,
.portfolio-section,
.clients-section,
.cta-section {
  overflow-x: hidden;
}

/* ── 1200px ── */
@media (max-width: 1200px) {
  .portfolio-grid { grid-template-columns: repeat(3, 1fr); }
}

/* ── 1024px ── */
@media (max-width: 1024px) {
  .hero-section::before { width: 35%; }
  .hero-headline { font-size: clamp(2rem, 5vw, 3.5rem); }

  /* Stats — 2 columns */
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .stat-item { padding: 1.25rem 1.25rem; }
  .stat-item:nth-child(2) { border-right: none; }
  .stat-item:nth-child(1),
  .stat-item:nth-child(2) { border-bottom: 1px solid rgba(0,0,0,0.08); }

  /* Services — 2 col */
  .services-grid { grid-template-columns: 1fr 1fr; }
  .services-grid .service-card:last-child { grid-column: 1 / -1; }

  /* Why Choose Us — stack */
  .why-inner        { grid-template-columns: 1fr; min-height: auto; }
  .why-image-col    { min-height: 280px; max-height: 380px; }
  .why-image        { min-height: 280px; max-height: 380px; }
  .why-image-overlay{ background: linear-gradient(to bottom, transparent 50%, #0D0D0D 100%); }
  .why-copy-col     { padding: 2.5rem var(--px) 3rem; }
  .why-headline     { font-size: clamp(2rem, 5vw, 3rem); }

  /* CTA — stack */
  .cta-inner  { grid-template-columns: 1fr; gap: 1.5rem; }
  .cta-right  { align-items: flex-start; }
  .cta-desc   { text-align: left; max-width: 100%; }
}

/* ── 860px ── */
@media (max-width: 860px) {
  /* Services — 2 col still but smaller */
  .services-section { padding: 4rem 0 3.5rem; }
  .services-head { margin-bottom: 2.5rem; }
}

/* ── 768px ── */
@media (max-width: 768px) {
  /* Hero */
  .hero-section        { padding: 3rem 0 2rem; min-height: auto; }
  .hero-section::before{ display: none; }
  .hero-section::after { display: none; }
  .hero-inner          { grid-template-columns: 1fr; gap: 1.5rem; }
  .hero-visual-wrap    { order: -1; max-width: 300px; margin: 0 auto; }
  .hero-headline       { font-size: clamp(2.2rem, 8vw, 3rem); }
  .hero-kicker         { font-size: 0.65rem; }
  .hero-desc           { font-size: 0.88rem; margin-bottom: 1.5rem; }

  /* Stats */
  .stats-section { padding: 2.5rem 0; }
  .stat-item     { padding: 1rem; gap: 0.75rem; }
  .stat-icon     { width: 40px; height: 40px; }

  /* Services */
  .services-grid { grid-template-columns: 1fr; }
  .services-grid .service-card:last-child { grid-column: auto; }
  .service-card  { min-height: 280px; }

  /* Portfolio */
  .portfolio-section { padding: 4rem 0 3rem; }
  .portfolio-head    { flex-direction: column; align-items: flex-start; gap: 1rem; }
  .portfolio-filters { gap: 0.3rem; }
  .filter-tab        { font-size: 0.65rem; padding: 0.38rem 0.75rem; }
  .portfolio-grid    { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }

  /* Clients */
  .clients-section { padding: 3rem 0; }
  .clients-row     { gap: 1.5rem 2.5rem; }

  /* CTA */
  .cta-section    { padding: 3.5rem 0; }
  .cta-headline   { font-size: clamp(1.8rem, 7vw, 2.8rem); }
  .cta-deco       { display: none; }
}

/* ── 480px ── */
@media (max-width: 480px) {
  /* Hero */
  .hero-section   { padding: 2rem 0 1.5rem; }
  .hero-headline  { font-size: clamp(2rem, 10vw, 2.8rem); line-height: 1; }
  .hero-actions   { gap: 0.75rem; }
  .btn-primary    { padding: 0.75rem 1.25rem; font-size: 0.72rem; }
  .hero-visual-wrap { max-width: 260px; }

  /* Stats — 1 column */
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .stat-item  {
    padding: 0.9rem 0.75rem;
    gap: 0.6rem;
    border-right: none;
    border-bottom: 1px solid rgba(0,0,0,0.07);
  }
  .stat-item:nth-child(odd)  { border-right: 1px solid rgba(0,0,0,0.07); }
  .stat-item:nth-child(3),
  .stat-item:nth-child(4)    { border-bottom: none; }
  .stat-icon  { width: 36px; height: 36px; }
  .stat-value { font-size: 1.4rem; }
  .stat-label { font-size: 0.62rem; }

  /* Services */
  .services-section { padding: 3rem 0 2.5rem; }

  /* Why */
  .why-copy-col   { padding: 2rem var(--px) 2.5rem; }
  .why-feature    { gap: 0.75rem; }
  .why-feature-icon { width: 32px; height: 32px; }

  /* Portfolio */
  .portfolio-grid { grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .portfolio-filters {
    overflow-x: auto;
    flex-wrap: nowrap;
    padding-bottom: 0.4rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .portfolio-filters::-webkit-scrollbar { display: none; }
  .filter-tab { flex-shrink: 0; }

  /* Clients */
  .client-logo svg { height: 20px; }
  .clients-row     { gap: 1.2rem 2rem; }

  /* CTA */
  .cta-section  { padding: 3rem 0; }
  .cta-headline { font-size: clamp(1.6rem, 8vw, 2.4rem); }
  .btn-cta      { width: 100%; justify-content: center; }
}

/* ── 360px (very small) ── */
@media (max-width: 360px) {
  .hero-headline  { font-size: 1.9rem; }
  .hero-visual-wrap { max-width: 220px; }
  .portfolio-grid { grid-template-columns: 1fr; }
  .stats-grid     { grid-template-columns: 1fr 1fr; }
}
